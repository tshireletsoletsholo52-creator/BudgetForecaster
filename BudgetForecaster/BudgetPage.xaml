<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BudgetForecaster.BudgetPage"
             Title="Budget">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Text="&lt;" Command="{Binding PreviousMonthCommand}" />
            <Label Grid.Column="1" Text="{Binding MonthLabel}" FontSize="22" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="&gt;" Command="{Binding NextMonthCommand}" />
        </Grid>

        <Button Grid.Row="1" Text="Copy last month's budget" Command="{Binding CopyLastMonthCommand}" />

        <VerticalStackLayout Grid.Row="2">
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
            <Label Text="{Binding InfoMessage}" TextColor="SeaGreen" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,140" ColumnSpacing="10" Padding="0,4">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding TypeLabel}" FontSize="12" />
                        </VerticalStackLayout>
                        <Entry Grid.Column="1" Placeholder="0.00" Keyboard="Numeric"
                               HorizontalTextAlignment="End" Text="{Binding AmountText}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="4" Text="Save budget" Command="{Binding SaveCommand}" />
    </Grid>
</ContentPage>
